# Pin this to the exact official OpenClaw tag currently deployed.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:<PINNED_VERSION>
MILOCO_OPENCLAW_IMAGE=openclaw-miloco-dev:local

# Current checkout of this fork on the Unraid host.
MILOCO_SOURCE_DIR=/mnt/user/appdata/xiaomi-miloco

# Persist uv, downloaded Python runtimes, tool environments, and the writable source mirror.
OPENCLAW_LOCAL_DIR=/mnt/user/appdata/openclaw/.local
