# Copy the exact official image reference already pinned by the existing
# OpenClaw deployment. Do not use latest and do not point this at a derivative.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:<PINNED_VERSION>

# Current checkout of this fork on the Unraid host.
MILOCO_SOURCE_DIR=/mnt/user/appdata/xiaomi-miloco

# Persistent output written by the isolated builder and mounted read-only in
# the official OpenClaw runtime.
MILOCO_DIST_DIR=/mnt/user/appdata/xiaomi-miloco-dist

# Persist uv, downloaded Python runtimes, and uv tool environments.
OPENCLAW_LOCAL_DIR=/mnt/user/appdata/openclaw/.local

# Match the owner of MILOCO_DIST_DIR. The official OpenClaw image uses 1000.
MILOCO_BUILDER_UID=1000
MILOCO_BUILDER_GID=1000
